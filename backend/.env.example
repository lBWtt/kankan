# ============================================================
# 这个文件是干什么的：环境配置的"样板"——复制成 .env 后按环境填写。
#   标了【生产必改】的项不改，prod 模式下服务会拒绝启动或核心功能不可用。
# 它对应产品里的什么功能：告诉后端去哪里找数据库/缓存/对象存储/短信服务商。
# 如果它出错了（地址填错），用户会看到什么现象：App 所有内容加载失败，接口全部报错。
# ============================================================

# ---- 基础 ----
DATABASE_URL=postgresql+psycopg2://ccpj:ccpj_dev@localhost:15432/ccpj
REDIS_URL=redis://localhost:6379/0
# 【生产按拓扑设】反向代理层数：IP 限流的来源 IP 取值方式。
# 0=直连/未知（忽略可伪造的 X-Forwarded-For，用 socket 对端 IP）；
# N=我方有 N 层可信反代（如 nginx=1、CDN+nginx=2），取 XFF 从右数第 N 个。
# 直连却设成 >0，或经反代却留 0，都会让按 IP 限流失真/被绕过。
TRUSTED_PROXY_HOPS=0
# dev / prod：dev 接受万能验证码 888888；prod 启动时做配置自检
APP_ENV=dev
# 【生产必改】JWT 签名密钥：openssl rand -hex 32 生成强随机值
JWT_SECRET=dev-secret-change-in-prod

# ---- 媒体存储：local（单机盘）或 s3（S3 兼容对象存储，阿里云 OSS S3 兼容端点/AWS/MinIO）----
# 【生产必改】务必切 s3。注意：留 local 时**生产自检不会拦启动**（只在你选了 s3 却没配全时才报错），
# 服务照常起、媒体继续写单机盘——换机器/重启/迁移部署时图片视频会丢。别指望自检提醒，自己主动切。
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# storage_backend=s3 时以下必填：
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# 文件公开访问域名（CDN 或 Bucket 域名），最终图片 URL = 此域名 + /media/<文件名>
S3_PUBLIC_BASE_URL=

# ---- 短信服务商：console（验证码只写日志，开发用）或 aliyun ----
# 【生产必改】prod + console 会拒绝启动（用户无法登录）
SMS_PROVIDER=console
# sms_provider=aliyun 时以下必填（模板须含 ${code} 变量）：
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---- AI 抓取管线（python -m app.pipeline process 用；不影响线上服务运行）----
# 整理器：claude（默认）或 deepseek
AI_PROVIDER=claude
# 内容整理调 Claude API 的密钥；不配则只能用 collect 入池、不能跑 AI 整理
ANTHROPIC_API_KEY=
# 默认 claude-opus-4-8（Opus 4.8，当前在售）；如需换模型填 Anthropic 真实在售 ID
ANTHROPIC_MODEL=claude-opus-4-8
# AI_PROVIDER=deepseek 时用；⚠️ deepseek-chat 已下线，现用 deepseek-v4-flash（快/省）或 deepseek-v4-pro（质量）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 【生产建议设】AI 每日调用上限（防抓取洪峰把账单打爆；0=不限）。上线设个数如 500。
AI_DAILY_CALL_CAP=0
# 每批 AI 整理最多多少条（也受当日上限约束）
INGEST_BATCH_LIMIT=20

# ---- 采集调度 ----
# 【生产开】是否启用内置采集调度器（定时抓取入池）。dev 默认关，prod 想自动供内容则设 true。
INGEST_SCHEDULER_ENABLED=false

# ---- 分享 ----
# 【生产必改】分享卡回流的 Web 分享页域名（留占位则分享链接 404）
SHARE_BASE_URL=https://share.example.dev

# ---- 内部审核台（Web /admin-web/）----
# dev 默认挂出方便本地审核；**非 dev（prod）默认不挂**，需显式 =1 才挂。
# 【生产建议】保持关闭（=0 或不设）；若要在生产开放，务必配合 IP 白名单/内网/Cloudflare Access，
# 别让审核台裸奔在公网（接口有 admin 兜底，但页面本身不该公开可见）。
ADMIN_WEB_ENABLED=0
