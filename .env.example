# ============================================================
# 这个文件是干什么的：环境配置的"样板"——复制成 .env 后按环境填写。
#   标了【生产必改】的项不改，prod 模式下服务会拒绝启动或核心功能不可用。
# 它对应产品里的什么功能：告诉后端去哪里找数据库/缓存/对象存储/短信服务商。
# 如果它出错了（地址填错），用户会看到什么现象：App 所有内容加载失败，接口全部报错。
# ============================================================

# ---- 基础 ----
DATABASE_URL=postgresql+psycopg2://ccpj:ccpj_dev@localhost:15432/ccpj
REDIS_URL=redis://localhost:6379/0
# dev / prod：dev 接受万能验证码 888888；prod 启动时做配置自检
APP_ENV=dev
# 【生产必改】JWT 签名密钥：openssl rand -hex 32 生成强随机值
JWT_SECRET=dev-secret-change-in-prod

# ---- 媒体存储：local（单机盘）或 s3（S3 兼容对象存储，阿里云 OSS S3 兼容端点/AWS/MinIO）----
# 【生产建议】切 s3，否则媒体落单机磁盘
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# storage_backend=s3 时以下必填：
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# 文件公开访问域名（CDN 或 Bucket 域名），最终图片 URL = 此域名 + /media/<文件名>
S3_PUBLIC_BASE_URL=

# ---- 短信服务商：console（验证码只写日志，开发用）或 aliyun ----
# 【生产必改】prod + console 会拒绝启动（用户无法登录）
SMS_PROVIDER=console
# sms_provider=aliyun 时以下必填（模板须含 ${code} 变量）：
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---- AI 抓取管线（python -m app.pipeline process 用；不影响线上服务运行）----
# 内容整理调 Claude API 的密钥；不配则只能用 collect 入池、不能跑 AI 整理
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- 分享 ----
# 【生产必改】分享卡回流的 Web 分享页域名
SHARE_BASE_URL=https://share.example.dev
